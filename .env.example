# ローカル開発用の環境変数の雛形。
# コピーして .env を作り、実際の値を入れる（.env は .gitignore 対象）。
#
#   cp .env.example .env

# Bedrock呼び出し用のAWS認証情報
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=jp.anthropic.claude-sonnet-4-6

# AmiVoice（文字起こし）のAPIキー開発環境用（本番環境にはコマンドですでに渡してます）
AMIVOICE_API_KEY=
